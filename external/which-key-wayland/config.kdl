timeout 0

font {
  size 16.0
  line-height 24.0
}

layout {
  width 500
  max-items 30
  padding 8
  radius 4
  anchor 2
  margin {
    top 0
    right 4
    bottom 4
    left 0
  }
}

bind {
  Space desc="Open browser" { spawn "google-chrome"; }
  a desc="Apps" {
    m desc="Steam" { sh "flatpak run --branch=stable --arch=x86_64 --command=polymc org.polymc.PolyMC"; }
    o desc="OBS Studio" { spawn "obs"; }
    p desc="Spotify" { spawn "spotify"; }
    s desc="Steam" { sh "flatpak run --branch=stable --arch=x86_64 --command=/app/bin/steam --file-forwarding com.valvesoftware.Steam"; }
  }
  b desc="Toggle bar visibility" { sh "noctalia msg bar-toggle"; }
  c desc="Calculator" { spawn "gnome-calculator"; }
  C desc="Clear clipboard history" { spawn "noctalia msg clipboard-clear"; }
  e desc="File manager" { spawn "nautilus"; }
  l desc="Lock" { sh "noctalia msg session lock" }
  m desc="Media" {
    i desc="Mute input" { sh "noctalia msg mic-mute" }
    o desc="Mute output" { sh "noctalia msg volume-mute" }
  }
  N desc="Niri" {
    l desc="Layers" { sh "foot --hold niri msg layers"; }
    o desc="Outputs" { spawn "foot" "--hold" "niri" "msg" "outputs"; }
    S desc="Clear Dynamic Cast Target" { sh "niri msg action clear-dynamic-cast-target" }
    s desc="Set Dynamic Cast Window for Focused" { sh "niri msg action set-dynamic-cast-window" }
    w desc="Windows" { sh "foot --hold niri msg windows"; }
  }
  n desc="Notifications" {
    c desc="Clear all" { sh "noctalia msg notification-clear-history" }
    d desc="Dismiss all" { sh "noctalia msg notification-clear-active" }
    m desc="Do not disturb" { sh "noctalia msg notification-dnd-toggle" }
  }
  p desc="Noctalia panels" {
    , desc="Settings" { sh "noctalia msg settings-toggle" }
    a desc="Audio" { sh "noctalia msg panel-toggle control-center audio" }
    b desc="Bluetooth" { sh "noctalia msg panel-toggle control-center bluetooth" }
    c desc="Calendar" { sh "noctalia msg panel-toggle control-center calendar" }
    k desc="Keybind Cheatsheet" { sh "noctalia msg panel-toggle kenn/keybind-cheatsheet:cheatsheet" }
    m desc="System monitor" { sh "noctalia msg panel-toggle control-center system" }
    n desc="Network" { sh "noctalia msg panel-toggle control-center network" }
    o desc="Media" { sh "noctalia msg panel-toggle control-center media" }
    s desc="Screen time" { sh "noctalia msg panel-toggle control-center screen-time" }
    w desc="Weather" { sh "noctalia msg panel-toggle control-center weather" }
    x desc="Control center" { sh "noctalia msg panel-toggle control-center" }
  }
  q desc="Session" { sh "noctalia msg panel-toggle session" }
  W desc="Wallpaper" {
    w desc="Wallpaper selector" { sh "noctalia msg panel-toggle wallpaper" }
    r desc="Apply random wallpaper" { sh "noctalia msg wallpaper-random" }
  }
  w desc="Window & Column" {
    c desc="Center column" { sh "niri msg action center-column" }
    f desc="Toggle window floating" { sh "niri msg action toggle-window-floating" }
    M desc="Windowed Fullscreen" { sh "niri msg action toggle-windowed-fullscreen" }
    m desc="Fullscreen" { sh "niri msg action fullscreen-window" }
    r desc="Reset window height" { sh "niri msg action reset-window-height" }
    s desc="Fill rest screen space" { sh "niri msg action expand-column-to-available-width" }
    t desc="Toggle column tabbed" { sh "niri msg action toggle-column-tabbed-display" }
    w desc="Center window" { sh "niri msg action center-window" }
  }
}
