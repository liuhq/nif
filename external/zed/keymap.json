[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-q": "zed::Quit",
      "f11": "zed::ToggleFullScreen",

      "f4": "debugger::Start",
      "shift-f4": "debugger::Restart",
      "ctrl-f4": "debugger::Stop",
      "f5": "debugger::Rerun",
      "shift-f5": "debugger::RerunSession",
      "ctrl-f5": "debugger::RunToCursor",
      "f6": "debugger::Pause",
      "f7": "debugger::StepOver",
      "f8": "debugger::StepInto",
      "f9": "debugger::StepOut",
      "f10": "debugger::StepBack",

      "\\ e": "project_panel::Toggle",
      "\\ d": "debug_panel::Toggle",
      "\\ x": "diagnostics::DeployCurrentFile",
      "\\ shift-x": "diagnostics::Deploy",

      "ctrl-w ctrl-q": ["pane::CloseActiveItem", { "save_intent": "close" }],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "menu": "editor::OpenContextMenu",
      "escape": "editor::Cancel",
      "backspace": "editor::Backspace",
      "delete": "editor::Delete",
      "tab": "editor::Tab",
      "shift-tab": "editor::Backtab",
      "ctrl-backspace": [
        "editor::DeleteToPreviousWordStart",
        { "ignore_newlines": false, "ignore_brackets": false },
      ],
      "ctrl-delete": [
        "editor::DeleteToNextWordEnd",
        { "ignore_newlines": false, "ignore_brackets": false },
      ],
      "shift-delete": "editor::Cut",
      "ctrl-insert": "editor::Copy",
      "shift-insert": "editor::Paste",
      "up": "editor::MoveUp",
      "down": "editor::MoveDown",
      "left": "editor::MoveLeft",
      "right": "editor::MoveRight",
      "ctrl-up": "editor::LineUp",
      "ctrl-down": "editor::LineDown",
      "ctrl-left": "editor::MoveToPreviousWordStart",
      "ctrl-right": "editor::MoveToNextWordEnd",
      "shift-up": "editor::SelectUp",
      "shift-down": "editor::SelectDown",
      "shift-left": "editor::SelectLeft",
      "shift-right": "editor::SelectRight",
      "pageup": "editor::MovePageUp",
      "pagedown": "editor::MovePageDown",
      "home": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": true, "stop_at_indent": true },
      ],
      "end": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": true }],
      "ctrl-home": "editor::MoveToBeginning",
      "ctrl-end": "editor::MoveToEnd",
      "ctrl-a": "editor::SelectAll",
      "alt-a": "editor::SelectLine",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }],
      "h": "vim::Left",
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "l": "vim::Right",
      "enter": "vim::NextLineStart",
      "backspace": "vim::PreviousLineStart",
      "tab": "vim::Tab",
      "shift-tab": "vim::Tab",
      "g h": [
        "editor::MoveToBeginningOfLine",
        { "stop_at_soft_wraps": true, "stop_at_indent": true },
      ],
      "g l": "vim::EndOfLine",
      "0": ["vim::StartOfLine", { "display_lines": true }],
      "$": ["vim::EndOfLine", { "display_lines": true }],
      "^": "vim::FirstNonWhitespace",
      "g ^": ["vim::FirstNonWhitespace", { "display_lines": true }],
      "g g": "vim::StartOfDocument",
      "shift-g": "vim::EndOfDocument",
      "{": "vim::StartOfParagraph",
      "}": "vim::EndOfParagraph",
      "(": "vim::SentenceBackward",
      ")": "vim::SentenceForward",
      "|": "vim::GoToColumn",

      // Word motions
      "alt-w": "vim::NextWordStart",
      "alt-e": "vim::NextWordEnd",
      "alt-b": "vim::PreviousWordStart",
      "alt-g alt-e": "vim::PreviousWordEnd",
      "shift-w": ["vim::NextWordStart", { "ignore_punctuation": true }],
      "shift-e": ["vim::NextWordEnd", { "ignore_punctuation": true }],
      "shift-b": ["vim::PreviousWordStart", { "ignore_punctuation": true }],
      "g shift-e": ["vim::PreviousWordEnd", { "ignore_punctuation": true }],
      // Subword motions
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd",

      "/": "vim::Search",
      "g /": "pane::DeploySearch",
      "?": ["vim::Search", { "backwards": true }],
      "ctrl-/": "buffer_search::DeployReplace",
      "*": "vim::MoveToNext",
      "#": "vim::MoveToPrevious",
      "g *": ["vim::MoveToNext", { "partial_word": true }],
      "g #": ["vim::MoveToPrevious", { "partial_word": true }],
      "n": "vim::MoveToNextMatch",
      "shift-n": "vim::MoveToPreviousMatch",
      "%": ["vim::Matching", { "match_quotes": true }],
      "f": ["vim::PushFindForward", { "before": false, "multiline": true }],
      "t": ["vim::PushFindForward", { "before": true, "multiline": true }],
      "shift-f": [
        "vim::PushFindBackward",
        { "after": false, "multiline": true },
      ],
      "shift-t": [
        "vim::PushFindBackward",
        { "after": true, "multiline": true },
      ],
      "m": "vim::PushMark",
      "\"": "vim::PushRegister",
      "'": ["vim::PushJump", { "line": true }],
      "`": ["vim::PushJump", { "line": false }],
      ".": "vim::Repeat",
      ";": "vim::RepeatFind",
      ",": "vim::RepeatFindReversed",
      "ctrl-]": "editor::GoToDefinition",
      "ctrl-[": "pane::GoToOlderTag",
      "v": "vim::ToggleVisual",
      "shift-v": "vim::ToggleVisualLine",
      "ctrl-v": "vim::ToggleVisualBlock",
      "g v": "vim::RestoreVisualSelection",
      "shift-r": "vim::ToggleReplace",
      "g shift-r": "vim::PushReplaceWithRegister",
      "ctrl-f": "vim::PageDown",
      "ctrl-b": "vim::PageUp",
      "ctrl-d": "vim::ScrollDown",
      "ctrl-u": "vim::ScrollUp",
      "ctrl-e": "vim::LineDown",
      "ctrl-y": "vim::LineUp",

      "g d": "editor::GoToDefinition",
      "ctrl-w ctrl-d": "editor::GoToDefinitionSplit",
      "g shift-d": "editor::GoToDeclaration",
      "ctrl-w shift-d": "editor::GoToTypeDefinitionSplit",
      "g y": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g .": "editor::ToggleCodeActions", // zed specific
      "space k": "editor::Hover",
      "space K": "editor::OpenDocs",
      "g m": "vim::SelectNextMatch",
      "g shift-m": "vim::SelectPreviousMatch",
      "g x": "editor::OpenUrl",
      "g f": "editor::OpenSelectedFilename",
      "g space": "editor::OpenExcerpts", // zed specific
      "ctrl-w space": "editor::OpenExcerptsSplit",
      "g t": "vim::GoToTab",
      "g shift-t": "vim::GoToPreviousTab",
      "g n": "pane::ActivateNextItem",
      "g p": "pane::ActivatePreviousItem",
      "g b": "pane::AlternateFile",
      "g ]": "vim::ChangeListNewer",
      "g [": "vim::ChangeListOlder",
      "g shift-i": "vim::InsertAtPrevious",

      "shift-h": "vim::WindowTop",
      "shift-m": "vim::WindowMiddle",
      "shift-l": "vim::WindowBottom",

      "q": "vim::ToggleRecord",
      "shift-q": "vim::ReplayLastRecording",
      "@": "vim::PushReplayRegister",

      "z t": "editor::ScrollCursorTop",
      "z z": "editor::ScrollCursorCenter",
      "z b": "editor::ScrollCursorBottom",
      "z a": "editor::ToggleFold",
      "z shift-a": "editor::ToggleFoldRecursive",
      "z c": "editor::Fold",
      "z shift-c": "editor::FoldRecursive",
      "z o": "editor::UnfoldLines",
      "z shift-o": "editor::UnfoldRecursive",
      "z f": "editor::FoldSelectedRanges",
      "z m": "editor::FoldAll",
      "z r": "editor::UnfoldAll",
      "z l": "vim::ColumnRight",
      "z h": "vim::ColumnLeft",
      "z shift-l": "vim::HalfPageRight",
      "z shift-h": "vim::HalfPageLeft",

      // Multiple cursor
      "s a": "editor::SelectAllMatches",
      "s h": "vim::SelectPrevious",
      "s j": "editor::AddSelectionBelow",
      "s k": "editor::AddSelectionAbove",
      "s l": "vim::SelectNext",
      // Skip next or prev
      "s n": ["editor::SelectNext", { "replace_newest": true }],
      "s p": ["editor::SelectPrevious", { "replace_newest": true }],

      // Count support
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9],
    },
  },
  {
    "context": "VimControl && VimCount",
    "bindings": {
      "0": ["vim::Number", 0],
      ":": "vim::CountCommand",
      "%": "vim::GoToPercentage",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual || vim_mode == operator)",
    "bindings": {
      "] ]": "vim::NextSectionStart",
      "] [": "vim::NextSectionEnd",
      "[ [": "vim::PreviousSectionStart",
      "[ ]": "vim::PreviousSectionEnd",
      "] m": "vim::NextMethodStart",
      "] shift-m": "vim::NextMethodEnd",
      "[ m": "vim::PreviousMethodStart",
      "[ shift-m": "vim::PreviousMethodEnd",
      "[ *": "vim::PreviousComment",
      "[ /": "vim::PreviousComment",
      "] *": "vim::NextComment",
      "] /": "vim::NextComment",
      "[ -": "vim::PreviousLesserIndent",
      "[ +": "vim::PreviousGreaterIndent",
      "[ =": "vim::PreviousSameIndent",
      "] -": "vim::NextLesserIndent",
      "] +": "vim::NextGreaterIndent",
      "] =": "vim::NextSameIndent",
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "] shift-b": "pane::ActivateLastItem",
      "[ shift-b": ["pane::ActivateItem", 0],
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] space": "vim::InsertEmptyLineBelow",
      "[ space": "vim::InsertEmptyLineAbove",
      "[ e": "editor::MoveLineUp",
      "] e": "editor::MoveLineDown",
      "[ f": "workspace::FollowNextCollaborator",
      "] f": "workspace::FollowNextCollaborator",
      "] }": ["vim::UnmatchedForward", { "char": "}" }],
      "[ {": ["vim::UnmatchedBackward", { "char": "{" }],
      "] )": ["vim::UnmatchedForward", { "char": ")" }],
      "[ (": ["vim::UnmatchedBackward", { "char": "(" }],
      "[ r": "vim::GoToPreviousReference",
      "] r": "vim::GoToNextReference",
      // tree-sitter related commands
      "[ x": "vim::SelectLargerSyntaxNode",
      "] x": "vim::SelectSmallerSyntaxNode",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      ":": "command_palette::Toggle",
      "i": "vim::InsertBefore",
      "a": "vim::InsertAfter",
      "shift-i": "vim::InsertFirstNonWhitespace",
      "shift-a": "vim::InsertEndOfLine",
      "o": "vim::InsertLineBelow",
      "shift-o": "vim::InsertLineAbove",
      "c": "vim::PushChange",
      "shift-c": "vim::ChangeToEndOfLine",
      "y": "vim::PushYank",
      "shift-y": "vim::YankLine",
      "p": "vim::Paste",
      "shift-p": ["vim::Paste", { "before": true }],
      "d": "vim::PushDelete",
      "shift-d": "vim::DeleteToEndOfLine",
      "delete": "vim::DeleteRight",
      "shift-s": "vim::SubstituteLine",
      "x": "vim::DeleteRight",
      "shift-x": "vim::DeleteLeft",
      "r": "vim::PushReplace",
      "shift-j": "vim::JoinLines",
      "g shift-j": "vim::JoinLinesNoWhitespace",
      "u": "vim::Undo",
      "shift-u": "vim::UndoLastLine",
      "ctrl-r": "vim::Redo",
      "~": "vim::ChangeCase",
      ">": "vim::PushIndent",
      "<": "vim::PushOutdent",
      "=": "vim::PushAutoIndent",
      "!": "vim::PushShellCommand",

      "alt-1": ["app_menu::OpenApplicationMenu", "Zed"],
      "alt-2": ["app_menu::OpenApplicationMenu", "File"],
      "alt-3": ["app_menu::OpenApplicationMenu", "Edit"],
      "alt-4": ["app_menu::OpenApplicationMenu", "Selection"],
      "alt-5": ["app_menu::OpenApplicationMenu", "View"],
      "alt-6": ["app_menu::OpenApplicationMenu", "Go"],
      "alt-7": ["app_menu::OpenApplicationMenu", "Run"],
      "alt-8": ["app_menu::OpenApplicationMenu", "Window"],
      "alt-9": ["app_menu::OpenApplicationMenu", "Help"],
      "alt-0": "auto_update::ViewReleaseNotesLocally",

      "\\ c": "editor::OpenContextMenu",
      "\\ ,": "zed::OpenSettingsFile",
      "\\ l m": "lsp_tool::ToggleMenu",
      "\\ l r": "editor::RestartLanguageServer",
      "\\ l s": "editor::StopLanguageServer",
      "\\ s": "outline::Toggle",
      "\\ shift-s": "project_symbols::Toggle",
      "\\ n": "activity_indicator::ShowErrorMessage",
      "\\ 0": "editor::DisplayCursorNames",

      "space \"": "vim::ToggleRegistersView",
      "space '": "vim::ToggleMarksView",
      "space enter": "workspace::Save",
      "space w o": "workspace::Open",
      "space w f": "workspace::OpenFiles",
      "space w n": "workspace::NewFile",
      "space w w": "workspace::NewWindow",

      "space e r": "editor::Rewrap",

      "space d d": "editor::ToggleBreakpoint",
      "space d D": "debugger::ToggleDataBreakpoint",
      "space d l": "editor::EditLogBreakpoint",
      "space d c": "debugger::ClearAllBreakpoints",
      "space d e": "editor::EnableBreakpoint",
      "space d x": "editor::DisableBreakpoint",

      "space f l": "vim::ShowLocation",

      "space g b": "editor::BlameHover",
      "space g a": "editor::ApplyDiffHunk",
      "space g shift-a": "editor::ApplyAllDiffHunks",
      "space g |": "editor::DiffClipboardWithSelection",

      "space x": ["pane::CloseActiveItem", { "save_intent": "close" }],

      "space y l": "editor::CopyFileLocation",
      "space y n": "editor::CopyFileName",
      "space y N": "editor::CopyFileNameWithoutExtension",

      "g =": "editor::Format",
      "g +": "editor::OrganizeImports",
      "g c": "vim::PushToggleComments",
      "g q": "vim::PushRewrap",
      "g ?": "vim::PushRot13",

      "ctrl-a": "vim::Increment",
      "ctrl-x": "vim::Decrement",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "escape": "vim::SwitchToNormalMode",
      ":": "vim::VisualCommand",
      "d": ["workspace::SendKeystrokes", "\" _ x"],
      "x": "vim::VisualDelete",
      "shift-d": ["workspace::SendKeystrokes", "\" _ shift-x"],
      "shift-x": "vim::VisualDeleteLine",
      "r": "vim::PushReplace",
      "y": "vim::VisualYank",
      "shift-y": "vim::VisualYankLine",
      "p": "vim::Paste",
      "shift-p": ["vim::Paste", { "preserve_clipboard": true }],
      "c": "vim::Substitute",
      "shift-r": "vim::SubstituteLine",
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }],
      "shift-i": "vim::InsertBefore",
      "shift-a": "vim::InsertAfter",
      "g shift-i": "vim::VisualInsertFirstNonWhiteSpace",
      "g shift-a": "vim::VisualInsertEndOfLine",
      "S": ["vim::PushAddSurrounds", {}],
      "shift-j": "vim::JoinLines",
      "g shift-j": "vim::JoinLinesNoWhitespace",

      "~": "vim::ChangeCase",
      "u": "vim::ConvertToLowerCase",
      "shift-u": "vim::ConvertToUpperCase",
      "space v k": "editor::ConvertToKebabCase",
      "space v l": "editor::ConvertToLowerCamelCase",
      "space v u": "editor::ConvertToUpperCamelCase",
      "space v s": "editor::ConvertToSnakeCase",

      "ctrl-a": "vim::Increment",
      "ctrl-x": "vim::Decrement",
      "g ctrl-a": ["vim::Increment", { "step": true }],
      "g ctrl-x": ["vim::Decrement", { "step": true }],

      "o": "vim::OtherEndRowAware",
      "*": ["vim::MoveToNext", { "partial_word": true }],
      "#": ["vim::MoveToPrevious", { "partial_word": true }],
      ">": "vim::Indent",
      "<": "vim::Outdent",
      "=": "vim::AutoIndent",
      "!": "vim::ShellCommand",

      "g l": ["workspace::SendKeystrokes", "g l h"],

      "g =": "editor::FormatSelections",
      "g c": "vim::ToggleComments",
      "g q": "vim::Rewrap",
      "g ?": "vim::ConvertToRot13",
    },
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-w": [
        "editor::DeleteToPreviousWordStart",
        { "ignore_newlines": false, "ignore_brackets": false },
      ],
      "ctrl-u": "editor::DeleteToBeginningOfLine",
      "ctrl-t": "vim::Indent",
      "ctrl-d": "vim::Outdent",
      "ctrl-y": "vim::InsertFromAbove",
      "ctrl-e": "vim::InsertFromBelow",
      "ctrl-r": "vim::PushRegister",
      "alt-o": "vim::TemporaryNormal",
    },
  },
  {
    "context": "showing_completions",
    "bindings": {
      "ctrl-k": "editor::ContextMenuPrevious",
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-d": "vim::ScrollDown",
      "ctrl-u": "vim::ScrollUp",
      "ctrl-l": "editor::ConfirmCompletion",
      "enter": "editor::ConfirmCompletionReplace",
      "ctrl-o": "editor::Cancel",
    },
  },
  {
    "context": "vim_mode == insert && !(showing_code_actions || showing_completions)",
    "bindings": {
      "escape": "vim::NormalBefore",
      "enter": "editor::Newline",
      "ctrl-h": "editor::MoveLeft",
      "ctrl-l": "editor::MoveRight",
      "ctrl-k": "editor::MoveUp",
      "ctrl-j": "editor::MoveDown",
      "ctrl-s": "editor::ShowSignatureHelp",
      "ctrl-o": "editor::ShowCompletions",
      "ctrl-x ctrl-w": "editor::ShowWordCompletions",
      "ctrl-x ctrl-s": "editor::InsertSnippet",
      "ctrl-x ctrl-u": "editor::InsertUuidV4",
      "ctrl-x ctrl-U": "editor::InsertUuidV7",
      "ctrl-x ctrl-c": "editor::ShowCharacterPalette",
    },
  },
  {
    "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-p": "editor::SignatureHelpPrevious",
      "ctrl-n": "editor::SignatureHelpNext",
    },
  },
  {
    "context": "vim_mode == replace",
    "bindings": {
      "escape": "vim::NormalBefore",
      "backspace": "vim::UndoReplace",
    },
  },
  {
    "context": "vim_mode == waiting",
    "bindings": {
      "tab": "vim::Tab",
      "enter": "vim::Enter",
      "escape": "vim::ClearOperators",
    },
  },
  {
    "context": "Editor && vim_mode == waiting && (vim_operator == ys || vim_operator == cs)",
    "bindings": {
      "escape": "vim::SwitchToNormalMode",
    },
  },
  {
    "context": "vim_mode == operator",
    "bindings": {
      "escape": "vim::ClearOperators",
      "g c": "vim::Comment",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "w": "vim::Word",
      "shift-w": ["vim::Word", { "ignore_punctuation": true }],
      "alt-w": "vim::Subword",
      "t": "vim::Tag",
      "s": "vim::Sentence",
      "p": "vim::Paragraph",
      "'": "vim::Quotes",
      "`": "vim::BackQuotes",
      "\"": "vim::DoubleQuotes",
      "q": "vim::MiniQuotes",
      "Q": "vim::AnyQuotes",
      "|": "vim::VerticalBars",
      "(": ["vim::Parentheses", { "opening": true }],
      ")": "vim::Parentheses",
      "b": "vim::MiniBrackets",
      "B": "vim::AnyBrackets",
      "[": ["vim::SquareBrackets", { "opening": true }],
      "]": "vim::SquareBrackets",
      "{": ["vim::CurlyBrackets", { "opening": true }],
      "}": "vim::CurlyBrackets",
      "<": ["vim::AngleBrackets", { "opening": true }],
      ">": "vim::AngleBrackets",
      "a": "vim::Argument",
      "i": "vim::IndentObj",
      "shift-i": ["vim::IndentObj", { "include_below": true }],
      "f": "vim::Method",
      "c": "vim::Class",
      "e": "vim::EntireFile",
    },
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "c": "vim::CurrentLine",
      "x": "vim::Exchange",
      "s": ["vim::PushChangeSurrounds", {}],
      "n": "editor::Rename",
    },
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "d": "vim::CurrentLine",
      "s": "vim::PushDeleteSurrounds",
      "o": "editor::ToggleSelectedDiffHunks",
      "shift-o": "git::ToggleStaged",
      "p": "git::Restore",
      "u": "git::StageAndNext",
      "shift-u": "git::UnstageAndNext",
    },
  },
  {
    "context": "vim_operator == g?",
    "bindings": {
      "?": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == gq",
    "bindings": {
      "q": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "y": "vim::CurrentLine",
      "s": ["vim::PushAddSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == ys",
    "bindings": {
      "s": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == >",
    "bindings": {
      ">": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == <",
    "bindings": {
      "<": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == gc",
    "bindings": {
      "c": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == gR",
    "bindings": {
      "shift-r": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == cx",
    "bindings": {
      "x": "vim::CurrentLine",
      "c": "vim::ClearExchange",
    },
  },
  {
    "context": "BufferSearchBar && !in_replace",
    "bindings": {
      "enter": "vim::SearchSubmit",
      "escape": "buffer_search::Dismiss",
    },
  },
  {
    "context": "(Pane && buffer_search_deployed) > Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "escape": "buffer_search::Dismiss",
    },
  },
  {
    "context": "VimControl && !menu && !Terminal",
    "bindings": {
      "ctrl-w": null,
      "ctrl-w ctrl-h": "vim::ResizePaneLeft",
      "ctrl-w ctrl-j": "vim::ResizePaneDown",
      "ctrl-w ctrl-k": "vim::ResizePaneUp",
      "ctrl-w ctrl-l": "vim::ResizePaneRight",
      "ctrl-w ctrl-left": "workspace::SwapPaneLeft",
      "ctrl-w ctrl-right": "workspace::SwapPaneRight",
      "ctrl-w ctrl-up": "workspace::SwapPaneUp",
      "ctrl-w ctrl-down": "workspace::SwapPaneDown",
