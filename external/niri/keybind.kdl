// noctalia-shell
// hotkey-overlay-title="" { spawn-sh "noctalia-shell "; }

binds {
    Mod+Escape repeat=false hotkey-overlay-title=null { close-window; }
    Ctrl+Alt+Delete { quit; }
    Mod+Backspace repeat=false { toggle-overview; }

    // #"WhichKey"
    Mod+Grave hotkey-overlay-title="Which Key" { spawn-sh "which-key-wayland"; }
    Mod+Shift+Grave hotkey-overlay-title="Which Key: Reload" { spawn-sh "which-key-wayland reload"; }
    Mod+Ctrl+Grave hotkey-overlay-title="Which Key: Quit" { spawn-sh "which-key-wayland quit"; }

    Mod+A hotkey-overlay-title="Which Key: Apps" { spawn-sh "which-key-wayland show a"; }
    Mod+B hotkey-overlay-title="Which Key: Noctalia panels" { spawn-sh "which-key-wayland show p"; }
    Mod+W hotkey-overlay-title="Which Key: Window & Column" { spawn-sh "which-key-wayland show w"; }
    Mod+Backslash hotkey-overlay-title="Which Key: Notifications" { spawn-sh "which-key-wayland show n"; }

    // #"Window"
    Mod+K { focus-window-up-or-bottom; }
    Mod+J { focus-window-down-or-top; }
    Mod+Ctrl+K repeat=false { move-window-up; }
    Mod+Ctrl+J repeat=false { move-window-down; }

    Mod+BracketLeft repeat=false { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false { consume-or-expel-window-right; }
    Mod+I repeat=false  { consume-window-into-column; }
    Mod+O repeat=false { expel-window-from-column; }

    Mod+Slash { switch-focus-between-floating-and-tiling; }

    // #"Column"
    Mod+H { focus-column-left-or-last; }
    Mod+L {  focus-column-right-or-first; }
    Mod+Ctrl+H repeat=false { move-column-left; }
    Mod+Ctrl+L repeat=false { move-column-right; }

    Mod+Shift+WheelScrollUp cooldown-ms=250 { focus-column-left; }
    Mod+Shift+WheelScrollDown cooldown-ms=250 { focus-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp cooldown-ms=250 { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=250 { move-column-right; }

    // #"Workspace"
    Mod+P { focus-workspace-up; }
    Mod+N { focus-workspace-down; }
    Mod+Ctrl+P repeat=false { move-column-to-workspace-up; }
    Mod+Ctrl+N repeat=false { move-column-to-workspace-down; }
    Mod+Shift+P repeat=false { move-workspace-up; }
    Mod+Shift+N repeat=false { move-workspace-down; }

    Mod+WheelScrollUp cooldown-ms=250 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=250 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=250 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=250 { move-column-to-workspace-down; }

    // #"Size"
    Mod+Tab repeat=false { switch-preset-column-width; }
    Mod+Shift+Tab repeat=false { switch-preset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // #"Run"
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }

    // #"Panel"
    Mod+D hotkey-overlay-title="Launcher" { spawn-sh "noctalia-shell ipc call launcher toggle"; }
    Mod+V hotkey-overlay-title="Clipboard Pick" { spawn-sh "noctalia-shell ipc call launcher clipboard"; }

    // #"Audio"
    Mod+Up hotkey-overlay-title="Increase output volume" { spawn-sh "noctalia-shell ipc call volume increase"; }
    Mod+Down hotkey-overlay-title="Decrease output volume" { spawn-sh "noctalia-shell ipc call volume decrease"; }
    Mod+Right hotkey-overlay-title="Previous Track" { spawn-sh "noctalia-shell ipc call media previous"; }
    Mod+Left hotkey-overlay-title="Next Track" { spawn-sh "noctalia-shell ipc call media next"; }
    Mod+Ctrl+Down hotkey-overlay-title="Toggle Playback" { spawn-sh "noctalia-shell ipc call media playPause"; }

    // #"Screenshots"
    Print repeat=false hotkey-overlay-title="Screenshot Region" { screenshot; }
    Mod+Print repeat=false hotkey-overlay-title="Screenshot window" { screenshot-window write-to-disk=false; }
    Shift+Print repeat=false hotkey-overlay-title="Screenshot Output (Save)" { screenshot-screen; }
}

